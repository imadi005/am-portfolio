# Cashfree Payment Gateway credentials
# Get these from https://merchant.cashfree.com/merchants/login -> Developers -> API Keys
CASHFREE_APP_ID=your_app_id_here
CASHFREE_SECRET_KEY=your_secret_key_here

# TEST for sandbox testing, PRODUCTION for live payments
CASHFREE_ENV=TEST

# Must match CASHFREE_ENV: "sandbox" or "production" (used by the client-side Cashfree JS SDK)
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Public base URL of the deployed site, used to build Cashfree's return_url.
# For local dev this can stay unset (falls back to the request origin).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
